# Enable Dropbear (set NO_START=0 to enable, NO_START=1 to disable)
NO_START=0

# The TCP port that Dropbear listens on
DROPBEAR_PORT=143

# Additional arguments for Dropbear
# Only use standard and secure ports
DROPBEAR_EXTRA_ARGS="-p 50000 -p 109 -p 110"

# Specify an optional banner file containing a message to be
# sent to clients before they connect
# Ensure the banner file exists and contains appropriate content
DROPBEAR_BANNER="/etc/issue.net"

# RSA hostkey file (default: /etc/dropbear/dropbear_rsa_host_key)
# Uncomment and specify a custom path if needed
#DROPBEAR_RSAKEY="/etc/dropbear/dropbear_rsa_host_key"

# DSS hostkey file (default: /etc/dropbear/dropbear_dss_host_key)
# Uncomment and specify a custom path if needed
#DROPBEAR_DSSKEY="/etc/dropbear/dropbear_dss_host_key"

# ECDSA hostkey file (default: /etc/dropbear/dropbear_ecdsa_host_key)
# Uncomment and specify a custom path if needed
#DROPBEAR_ECDSAKEY="/etc/dropbear/dropbear_ecdsa_host_key"

# Receive window size - this is a tradeoff between memory and
# network performance
DROPBEAR_RECEIVE_WINDOW=65536
